# ─────────────────────────────────────────────────────────────
# CairoPet — variáveis de ambiente
# Copie para .env (local) e configure as mesmas no painel da Vercel.
# Nenhum ID abaixo é real: deixe vazio o que ainda não existir.
# ─────────────────────────────────────────────────────────────

# Domínio canônico (usado em canonical, Open Graph e sitemap)
PUBLIC_SITE_URL=

# ── Tracking (públicas) ──────────────────────────────────────
# Meta Pixel — só números. Ex.: 123456789012345
PUBLIC_META_PIXEL_ID=
# Google Tag Manager (padrão: GTM-MQPCCFFG, o container da CairoPet)
PUBLIC_GTM_ID=
# Google Analytics 4 — Ex.: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# ── Canais oficiais (públicas; vazio = não aparece no site) ─
PUBLIC_INSTAGRAM_URL=
# WhatsApp com DDI+DDD, só números. Ex.: 5511999999999
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_CONTACT_EMAIL=
# Dados legais (rodapé e Política de Privacidade)
PUBLIC_COMPANY_LEGAL_NAME=
PUBLIC_COMPANY_CNPJ=

# ── Leads (secretas, só servidor) ────────────────────────────
# Para onde cada lead é enviado (n8n, Make, Zapier, CRM, Apps Script...).
# Recebe um POST JSON. Sem essa variável, o formulário falha em produção
# de propósito — para nenhum lead ser perdido em silêncio.
LEAD_WEBHOOK_URL=
# Opcional: enviado como "Authorization: Bearer <token>"
LEAD_WEBHOOK_TOKEN=

# ── Meta Conversions API (secretas) ──────────────────────────
# Requer também PUBLIC_META_PIXEL_ID.
META_CAPI_ACCESS_TOKEN=
# Opcional: código da aba "Eventos de teste" do Gerenciador de Eventos
META_CAPI_TEST_EVENT_CODE=
# Opcional (padrão v23.0)
META_GRAPH_API_VERSION=
