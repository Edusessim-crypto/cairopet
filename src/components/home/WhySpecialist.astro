---
import Photo from '../Photo.astro';
import { KNOWN, STUDIED } from '../../data/content';
import { PHOTOS } from '../../data/photos';
---

<section id="por-que" class="sec why" aria-labelledby="why-title">
  <div class="wrap">
    <div class="why__head">
      <p class="kicker">Por que só agropecuárias</p>
      <h2 id="why-title" class="h2" data-in>Uma agência comum aprende o seu negócio do zero, com o seu dinheiro.</h2>
      <p class="lead" data-in>
        A CairoPet só trabalha com agropecuárias. O que se aprende de mercado já chega pronto — e o tempo vai para o que é
        da sua loja.
      </p>
    </div>

    <div class="why__grid">
      <div class="why__col why__col--known" data-in>
        <h3 class="why__title">O que já chega sabendo</h3>
        <p class="why__sub">Aprendido campanha a campanha, no segmento.</p>
        <ul class="why__list">
          {KNOWN.map((k) => <li>{k}</li>)}
        </ul>
      </div>

      <div class="why__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="M4 12h15M13 5.5 19.5 12 13 18.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </div>

      <div class="why__col why__col--store" data-in style="--d:0.08s">
        <h3 class="why__title">O que vai estudar na sua loja</h3>
        <p class="why__sub">Onde o seu dinheiro precisa ir.</p>
        <ul class="why__list">
          {STUDIED.map((k) => <li>{k}</li>)}
        </ul>
      </div>

      <div class="why__photo" data-in style="--d:0.12s">
        <Photo photo={PHOTOS.loja} ratio="4 / 5" sizes="(min-width: 60rem) 24vw, 100vw" />
      </div>
    </div>

    <p class="why__close" data-in>
      <strong>Menos tempo entendendo o mercado.</strong> Mais tempo entendendo a sua loja.
    </p>
  </div>
</section>

<style>
  .why__head {
    max-width: 46rem;
  }

  .why__head .lead {
    max-width: 44ch;
    margin-top: 1.25rem;
  }

  .why__grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .why__col {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--r);
  }

  .why__col--known {
    background: var(--mist);
  }

  .why__col--store {
    background: var(--ink);
    color: var(--white);
  }

  .why__title {
    font-size: var(--t-h3);
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .why__sub {
    margin-top: 0.25rem;
    font-size: var(--t-small);
    opacity: 0.7;
  }

  .why__list {
    display: grid;
    margin-top: 1.25rem;
    border-top: 1px solid currentColor;
  }

  .why__list li {
    padding-block: 0.7rem;
    border-bottom: 1px solid rgb(127 127 127 / 0.3);
    font-weight: 560;
    line-height: 1.35;
  }

  .why__arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    justify-self: center;
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    transform: rotate(90deg);
  }

  .why__arrow svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .why__photo {
    display: none;
  }

  .why__close {
    margin-top: 2rem;
    font-size: var(--t-h3);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }

  .why__close strong {
    color: var(--ink);
  }

  @media (min-width: 60rem) {
    .why__grid {
      grid-template-columns: 1fr auto 1fr 0.8fr;
      align-items: stretch;
      gap: 1rem;
    }

    .why__arrow {
      align-self: center;
      transform: none;
    }

    .why__photo {
      display: block;
    }

    .why__photo :global(.ph) {
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .why__photo :global(.ph__frame) {
      flex: 1;
      aspect-ratio: auto !important;
    }
  }
</style>
