---
import { SITUATIONS } from '../../data/content';

const TAGS = [
  { item: 'Estoque', ok: true },
  { item: 'Preço', ok: true },
  { item: 'Equipe', ok: true },
  { item: 'Movimento', ok: false },
];
---

<section id="a-loja" class="sec on-mist problem" aria-labelledby="problem-title">
  <div class="wrap">
    <div class="problem__top">
      <div class="problem__copy">
        <p class="kicker">A loja parada</p>
        <h2 id="problem-title" class="h2" data-in>Você tem estoque. Tem preço. Tem equipe.</h2>
        <p class="problem__turn" data-in>Mesmo assim, tem semana em que a loja fica parada.</p>
        <p class="lead" data-in>
          O movimento fica dependendo do clima, do dia do mês e do boca a boca. E o cliente não compra na loja que ele não
          lembra — lembra de quem aparece com constância.
        </p>
      </div>

      <div class="shelf" role="img" aria-label="Etiquetas de prateleira: estoque, preço e equipe em dia. Movimento: em falta." data-in>
        <div class="shelf__bar" aria-hidden="true"></div>
        <ul class="shelf__tags" aria-hidden="true">
          {
            TAGS.map((t, i) => (
              <li class:list={['tag', { 'tag--out': !t.ok }]} style={`--r:${[-2, 1.5, -1, 3][i]}deg`}>
                <span class="tag__hole" />
                <span class="tag__cod mono">ITEM 0{i + 1}</span>
                <span class="tag__name">{t.item}</span>
                <span class="tag__status mono">{t.ok ? 'Em dia' : 'Em falta'}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <fieldset class="check" data-situations>
      <legend class="check__legend h3">Quais destas já aconteceram na sua loja?</legend>
      <div class="check__grid">
        {
          SITUATIONS.map((s, i) => (
            <label class="check__item">
              <input type="checkbox" value={i} data-dores={s.dores.join('|')} />
              <span class="check__box" aria-hidden="true">
                <svg viewBox="0 0 12 12">
                  <path d="M2.5 6.3 5 8.7l4.5-5.2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span>{s.text}</span>
            </label>
          ))
        }
      </div>
      <p class="check__count mono" aria-live="polite" data-js-only>
        <span data-count>0</span> de {SITUATIONS.length} marcadas<span data-note hidden> · elas já vão marcadas no formulário</span>
      </p>
    </fieldset>
  </div>

  <div class="verdict">
    <div class="wrap verdict__in">
      <p class="verdict__a">Nada disso é falta de loja boa.</p>
      <p class="verdict__b">É falta de atenção.</p>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-situations]');
  if (root) {
    const KEY = 'cp_situacoes';
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    const count = root.querySelector('[data-count]')!;
    const note = root.querySelector<HTMLElement>('[data-note]')!;
    const save = () => {
      const checked = boxes.filter((b) => b.checked);
      count.textContent = String(checked.length);
      note.hidden = checked.length === 0;
      const dores = [...new Set(checked.flatMap((b) => (b.dataset.dores ?? '').split('|')).filter(Boolean))];
      try {
        localStorage.setItem(KEY, JSON.stringify({ marked: checked.map((b) => b.value), dores }));
      } catch {
        /* sem armazenamento: segue sem pré-marcar */
      }
    };
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) ?? 'null') as { marked: string[] } | null;
      saved?.marked.forEach((v) => {
        const b = boxes.find((x) => x.value === v);
        if (b) b.checked = true;
      });
    } catch {
      /* ignora */
    }
    save();
    root.addEventListener('change', save);
  }
</script>

<style>
  .problem {
    padding-bottom: 0;
  }

  .problem__top {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .problem__copy .h2 {
    max-width: 14ch;
  }

  .problem__turn {
    max-width: 22ch;
    margin: 1rem 0 1.25rem;
    font-size: var(--t-h3);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .problem__copy .lead {
    max-width: 44ch;
  }

  /* Prateleira com etiquetas --------------------------------------------------- */
  .shelf {
    position: relative;
    padding-top: 0.5rem;
  }

  .shelf__bar {
    height: 10px;
    border-radius: 3px;
    background: var(--ink);
  }

  .shelf__tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 0.875rem;
    padding-top: 1.25rem;
  }

  .tag {
    position: relative;
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1rem 1rem;
    border-radius: 6px;
    background: var(--white);
    border: 1px solid var(--ink);
    transform: rotate(var(--r));
    transform-origin: 50% -1.25rem;
  }

  .tag::before {
    content: '';
    position: absolute;
    top: -1.35rem;
    left: 50%;
    width: 1px;
    height: 1.3rem;
    background: var(--ink);
  }

  .tag__hole {
    position: absolute;
    top: 0.45rem;
    left: 50%;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--mist);
    transform: translateX(-50%);
  }

  .tag__cod {
    color: var(--ink-3);
    font-size: 0.625rem;
  }

  .tag__name {
    font-family: var(--font-display), sans-serif;
    font-size: 1.125rem;
    overflow-wrap: anywhere;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tag__status {
    justify-self: start;
    margin-top: 0.25rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--ink);
    color: var(--white);
    font-size: 0.625rem;
    text-transform: uppercase;
  }

  .tag--out {
    border-style: dashed;
    background: transparent;
  }

  .tag--out .tag__name {
    color: var(--ink-2);
  }

  .tag--out .tag__status {
    background: transparent;
    color: var(--ink);
    border: 1.5px solid var(--ink);
  }

  /* Checklist --------------------------------------------------------------- */
  .check {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  .check__legend {
    margin-bottom: 1.25rem;
  }

  .check__grid {
    display: grid;
    gap: 0.625rem;
  }

  .check__item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1rem 1.1rem;
    border-radius: var(--r-sm);
    background: var(--white);
    border: 1px solid transparent;
    font-weight: 560;
    line-height: 1.4;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .check__item:hover {
    border-color: var(--ink);
  }

  .check__item input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .check__box {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.05rem;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    color: transparent;
    transition: background-color 0.15s var(--ease);
  }

  .check__box svg {
    width: 0.85rem;
    height: 0.85rem;
  }

  .check__item:has(input:checked) {
    border-color: var(--ink);
  }

  .check__item:has(input:checked) .check__box {
    background: var(--ink);
    color: var(--white);
  }

  .check__item:has(input:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .check__count {
    margin-top: 1rem;
    color: var(--ink-2);
  }

  /* Veredito --------------------------------------------------------------- */
  .verdict {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-block: clamp(3rem, 6vw, 4.5rem);
    background: var(--black);
    color: var(--white);
  }

  .verdict__in {
    display: grid;
    gap: 0.5rem;
  }

  .verdict__a {
    color: rgb(255 255 255 / 0.72);
    font-size: var(--t-h3);
    font-weight: 600;
  }

  .verdict__b {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  @media (min-width: 48rem) {
    .shelf__tags {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .tag {
      padding-inline: 0.75rem;
    }

    .tag__name {
      font-size: 1rem;
    }

    .check__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .problem__top {
      grid-template-columns: 1fr 1.05fr;
      gap: 4rem;
    }

    .verdict__in {
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 1.5rem;
    }
  }
</style>
