---
/**
 * Checklist para marcar junto com o cliente na reunião.
 * Clique na linha ou tecla 1–9 enquanto este slide está na tela.
 */
import Slide from '../Slide.astro';
import { DIAGNOSIS } from '../../../data/presentation';
---

<Slide id="diagnostico" theme="light">
  <div class="dg">
    <div class="dg__intro">
      <h2 class="pr-title dg__title" data-reveal="title" set:html={DIAGNOSIS.title} />
      <p class="pr-lead dg__lead" data-reveal>{DIAGNOSIS.text}</p>
    </div>

    <ol class="dg__list" aria-label="Diagnóstico da empresa">
      {
        DIAGNOSIS.items.map((item, i) => (
          <li data-reveal>
            <label class="dg__item">
              <input class="dg__input" type="checkbox" data-diagnosis={i + 1} />
              <span class="dg__box" aria-hidden="true">
                <svg viewBox="0 0 16 16">
                  <path d="m3.5 8.4 2.9 2.8 6.1-6.4" />
                </svg>
              </span>
              <span class="dg__text">{item}</span>
              <span class="dg__num pr-mono" aria-hidden="true">
                {i + 1}
              </span>
            </label>
          </li>
        ))
      }
    </ol>
  </div>
</Slide>

<style>
  .dg {
    display: grid;
    gap: clamp(1.25rem, 3.6dvh, 2rem);
    flex: 1;
  }

  .dg__lead {
    max-width: 24em;
    margin-top: 1em;
  }

  .dg__list {
    border-top: 1px solid var(--c-rule);
    counter-reset: none;
  }

  .dg__list li {
    border-bottom: 1px solid var(--c-rule);
  }

  .dg__item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.875rem, calc(var(--u) * 1.4), 1.5rem);
    min-height: clamp(2.875rem, 7.4dvh, 5rem);
    padding: 0.55rem 0.25rem 0.55rem 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .dg__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .dg__box {
    display: grid;
    place-items: center;
    width: clamp(1.25rem, calc(var(--u) * 1.65), 1.875rem);
    aspect-ratio: 1;
    border: 1.5px solid var(--c-fg);
    border-radius: 5px;
    transition:
      background-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .dg__box svg {
    width: 78%;
    fill: none;
    stroke: var(--white);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 14;
    stroke-dashoffset: 14;
    transition: stroke-dashoffset 0.3s var(--ease) 0.05s;
  }

  .dg__text {
    font-size: calc(var(--fs-body) * 1.08);
    font-weight: 500;
    line-height: 1.3;
    transition: color 0.2s var(--ease);
  }

  .dg__num {
    display: grid;
    place-items: center;
    width: 2.1em;
    aspect-ratio: 1;
    border: 1px solid var(--c-rule);
    border-radius: 4px;
    color: var(--c-fg-2);
    letter-spacing: 0;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .dg__item:hover .dg__box {
    background: var(--mist);
  }

  .dg__input:checked ~ .dg__box {
    background: var(--ink);
  }

  .dg__input:checked ~ .dg__box svg {
    stroke-dashoffset: 0;
  }

  .dg__input:checked ~ .dg__num {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--white);
  }

  .dg__input:focus-visible ~ .dg__box {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .dg__item:active .dg__box {
    transform: scale(0.94);
  }

  @media (min-width: 60rem) and (min-aspect-ratio: 1/1) {
    .dg {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
      gap: calc(var(--gap) * 2);
    }

    .dg__intro {
      position: sticky;
      top: 0;
    }
  }
</style>
