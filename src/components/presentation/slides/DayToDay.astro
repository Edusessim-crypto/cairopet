---
import Slide from '../Slide.astro';
import { DAY_TO_DAY } from '../../../data/presentation';
---

<Slide id="dia-a-dia">
  <div class="dd">
    <h2 class="pr-title dd__title" data-reveal="title" set:html={DAY_TO_DAY.title} />

    <ol class="dd__list">
      {
        DAY_TO_DAY.steps.map((step, i) => (
          <li class="dd__step" data-reveal>
            <span class="pr-node" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="dd__copy">
              <h3 class="pr-h3">{step.title}</h3>
              <p class="pr-text">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Slide>

<style>
  .dd {
    display: grid;
    flex: 1;
    gap: clamp(1.5rem, 4.4dvh, 3rem);
  }

  .dd__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    column-gap: var(--gap);
    align-content: start;
  }

  .dd__step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding-block: clamp(0.9rem, 2.4dvh, 1.6rem);
    border-top: 1px solid var(--c-rule);
  }

  .dd__copy {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    padding-top: 0.45em;
  }

  .dd__copy .pr-text {
    max-width: 26em;
  }

  /* Desktop: título à esquerda, as seis etapas em duas colunas à direita */
  @media (min-width: 60rem) and (min-aspect-ratio: 1/1) {
    .dd {
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      align-items: start;
      gap: calc(var(--gap) * 2);
    }

    .dd__title {
      font-size: calc(var(--fs-h1) * 1.18);
      max-width: 6em;
    }

    .dd__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: calc(var(--gap) * 1.4);
    }

    .dd__step {
      padding-block: clamp(0.9rem, calc(var(--u) * 1.3), 2rem) clamp(1rem, calc(var(--u) * 1.8), 2.5rem);
    }
  }
</style>
