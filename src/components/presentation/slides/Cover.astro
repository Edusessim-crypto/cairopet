---
import { Picture } from 'astro:assets';
import Slide from '../Slide.astro';
import { COVER } from '../../../data/presentation';

// Quebra do PPT: "ESPECIALISTAS EM / MARKETING PARA AGROPECUÁRIAS"
const cut = COVER.tagline.indexOf(' marketing');
const tagline = cut > 0 ? [COVER.tagline.slice(0, cut), COVER.tagline.slice(cut + 1)] : [COVER.tagline];
---

<Slide id="capa" label={false}>
  <p class="cover__tagline pr-mono" data-reveal>{tagline.map((line) => <span>{line}</span>)}</p>

  <div class="cover__body">
    <h1 class="cover__title" data-reveal="title">
      {COVER.title.map((line) => <span class="cover__line">{line}</span>)}
      <span class="cover__highlight"><span>{COVER.highlight}</span></span>
    </h1>
    <p class="cover__text pr-lead" data-reveal>{COVER.text}</p>
    <button class="cover__go" type="button" data-next data-reveal>
      <span class="cover__circle" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 5v13M6 12.5l6 6 6-6" /></svg>
      </span>
      <span class="pr-mono">{COVER.action}</span>
    </button>
  </div>

  <p class="cover__footer pr-mono" data-reveal>{COVER.footer}</p>

  <div class="cover__photo">
    <Picture
      src={COVER.photo.src}
      alt={COVER.photo.alt}
      formats={['avif', 'webp']}
      widths={[400, COVER.photo.src.width]}
      sizes="(min-width: 60rem) 36vw, 90vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</Slide>

<style>
  .cover__tagline {
    position: absolute;
    top: calc(var(--pt) + env(safe-area-inset-top));
    left: calc(var(--px) + env(safe-area-inset-left) + var(--logo-w) + var(--gap) * 1.25);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--logo-h);
    color: var(--c-fg-2);
  }

  .cover__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.25rem, 3.4dvh, 2rem);
    margin-block: auto;
  }

  .cover__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-family: var(--font-display), 'Arial Black', sans-serif;
    font-size: var(--fs-display);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  /* "PRECISA VENDER MAIS." numa tarja branca, como no PPT */
  .cover__highlight {
    margin-top: 0.3em;
    padding: 0.1em 0.22em 0.06em;
    background: var(--white);
    color: var(--black);
    font-size: 0.74em;
    letter-spacing: -0.035em;
  }

  .cover__text {
    max-width: 27em;
    color: rgb(255 255 255 / 0.82);
  }

  .cover__go {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    margin-top: 0.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    text-align: left;
  }

  .cover__go .pr-mono {
    max-width: 13em;
    line-height: 1.6;
  }

  .cover__circle {
    display: grid;
    flex: none;
    place-items: center;
    width: clamp(3.25rem, calc(var(--u) * 4.4), 5.5rem);
    aspect-ratio: 1;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .cover__circle svg {
    width: 42%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s var(--ease);
  }

  .cover__go:hover .cover__circle {
    background: var(--white);
    color: var(--black);
  }

  .cover__go:hover .cover__circle svg {
    transform: translateY(2px);
  }

  /* Rodapé do PPT na mesma linha dos controles */
  .cover__footer {
    position: absolute;
    z-index: 1;
    left: calc(var(--px) + env(safe-area-inset-left));
    bottom: calc(clamp(0.75rem, calc(var(--pb) / 2 - 1.375rem), 2.5rem) + env(safe-area-inset-bottom) + 1.375rem);
    color: var(--c-fg-2);
    font-size: max(0.625rem, calc(var(--fs-mono) * 0.92));
    transform: translateY(50%);
  }

  /* Celular e tablet em pé: texto em cima; a foto ocupa o espaço que sobra embaixo,
     de ponta a ponta, sem nunca ficar atrás do texto. */
  .cover__photo {
    flex: 1 1 0;
    min-height: 0;
    margin: clamp(0.75rem, 2.5dvh, 1.5rem) calc(-1 * (var(--px) + env(safe-area-inset-right))) calc(-1 * var(--pb))
      calc(-1 * (var(--px) + env(safe-area-inset-left)));
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 35%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 35%);
  }

  .cover__photo :global(picture),
  .cover__photo :global(img) {
    width: 100%;
    height: 100%;
  }

  .cover__photo :global(img) {
    object-fit: cover;
    object-position: 74% 16%;
  }

  /* Momento: a foto assenta (zoom leve) e "Precisa vender mais." se revela por último */
  :global(.slide.is-active) .cover__photo {
    animation: cover-photo 1.2s var(--ease) both;
  }

  :global(.slide.is-active) .cover__highlight {
    animation: pr-wipe-right var(--m-base) var(--ease) 0.75s both;
  }

  @keyframes cover-photo {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @media (max-width: 59.99rem), (max-aspect-ratio: 1/1) {
    .cover__tagline {
      font-size: 0.625rem;
    }

    /* O mesmo texto já está ao lado do logo */
    .cover__footer {
      display: none;
    }

    .cover__body {
      margin-block: 0;
    }

    .cover__text {
      max-width: 19em;
    }
  }

  /* Tela baixa (celular deitado): só o texto */
  @media (max-height: 34rem) and (max-width: 59.99rem) {
    .cover__photo {
      display: none;
    }
  }

  @media (min-width: 60rem) and (min-aspect-ratio: 1/1) {
    .cover__body {
      max-width: 72%;
    }

    /* Desktop: a foto sangra pela direita e funde no preto */
    .cover__photo {
      position: absolute;
      z-index: 0;
      top: 0;
      right: 0;
      bottom: 0;
      flex: none;
      width: auto;
      height: 100%;
      margin: 0;
      aspect-ratio: 582 / 962;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 30%), linear-gradient(to bottom, transparent 0, #000 12%);
      mask-image: linear-gradient(to right, transparent 0, #000 30%), linear-gradient(to bottom, transparent 0, #000 12%);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }

    .cover__photo :global(picture),
    .cover__photo :global(img) {
      height: 100%;
    }

    .cover__photo :global(img) {
      object-position: center;
    }
  }
</style>
