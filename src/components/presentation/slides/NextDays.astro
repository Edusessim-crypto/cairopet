---
/**
 * Os próximos 15 dias: régua com 7 marcos (horizontal no desktop, vertical no celular).
 * Marcos do lojista com nó preenchido e selo "Você"; os da CairoPet, só contorno.
 * A linha é feita de um trecho por marco, para cada nó acender quando a linha chega nele.
 */
import Slide from '../Slide.astro';
import { NEXT_DAYS } from '../../../data/presentation';

const last = NEXT_DAYS.milestones.length - 1;
---

<Slide id="proximos-dias">
  <div class="nd__head">
    <h2 class="pr-title nd__title" data-reveal="title" set:html={NEXT_DAYS.title} />
    <div class="nd__aside" data-reveal>
      <p class="pr-lead">{NEXT_DAYS.text}</p>
      <p class="pr-mono nd__legend">
        <span class="nd__key nd__key--voce">{NEXT_DAYS.who.voce}</span>
        <span aria-hidden="true">·</span>
        <span class="nd__key">{NEXT_DAYS.who.cairopet}</span>
      </p>
    </div>
  </div>

  <ol class="nd">
    {
      NEXT_DAYS.milestones.map((m, k) => (
        <li class:list={['nd__ms', `nd__ms--${m.who}`, { 'is-live': m.day === NEXT_DAYS.live }]} style={`--k:${k}`}>
          {k < last && <span class="nd__seg" aria-hidden="true" />}
          <span class="nd__who pr-mono">
            {m.who === 'voce' ? <span class="nd__you">{NEXT_DAYS.who.voce}</span> : <span class="visually-hidden">{NEXT_DAYS.who.cairopet}</span>}
          </span>
          <span class="nd__node" aria-hidden="true">
            {m.day}
          </span>
          <div class="nd__copy">
            <p class="pr-mono nd__day">Dia {m.day}</p>
            <h3 class="nd__name">{m.title}</h3>
            <p class="nd__text">{m.text}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="pr-note nd__note" data-reveal>{NEXT_DAYS.note}</p>
</Slide>

<style>
  .nd__head {
    display: flex;
    flex-direction: column;
    gap: 0.8em;
  }

  .nd__aside {
    display: flex;
    flex-direction: column;
    gap: 0.6em;
  }

  .nd__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em 0.75em;
    color: var(--c-fg-2);
  }

  .nd__key {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
  }

  .nd__key::before {
    content: '';
    width: 0.85em;
    height: 0.85em;
    border: 1px solid var(--c-fg);
    border-radius: 50%;
  }

  .nd__key--voce::before {
    background: var(--c-fg);
  }

  .nd {
    --node: 2.5rem;
    --row-gap: 1.25rem;
    display: grid;
    gap: var(--row-gap);
    margin-top: clamp(1.5rem, 4.5dvh, 2.5rem);
  }

  /* Celular: nó à esquerda, texto à direita */
  .nd__ms {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) minmax(0, 1fr);
    grid-template-areas:
      'node who'
      'node copy';
    column-gap: 1rem;
    align-items: start;
  }

  .nd__who {
    grid-area: who;
  }

  .nd__you {
    display: inline-block;
    margin-bottom: 0.5em;
    padding: 0.3em 0.6em 0.25em;
    border: 1px solid var(--c-fg);
    border-radius: 4px;
    color: var(--c-fg);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .nd__node {
    position: relative;
    z-index: 1;
    display: grid;
    grid-area: node;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border: 1px solid var(--c-fg);
    border-radius: 50%;
    background: var(--c-bg);
    color: var(--c-fg);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: calc(var(--fs-mono) * 1.1);
    font-weight: 700;
  }

  .nd__ms--voce .nd__node {
    background: var(--c-fg);
    color: var(--c-bg);
  }

  /* Anel que se expande uma vez no "Operação no ar" */
  .is-live .nd__node::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--c-fg);
    border-radius: 50%;
    opacity: 0;
  }

  .nd__copy {
    display: flex;
    flex-direction: column;
    grid-area: copy;
    gap: 0.35em;
    padding-top: 0.2em;
  }

  .nd__day {
    color: var(--c-fg);
    font-weight: 700;
  }

  .nd__name {
    font-family: var(--font-display), 'Arial Black', sans-serif;
    font-size: var(--fs-h3);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .nd__text {
    color: var(--c-fg-2);
    font-size: var(--fs-small);
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* Trecho da régua até o próximo marco: trilho fino + preenchimento */
  .nd__seg {
    position: absolute;
    top: calc(var(--node) / 2);
    left: calc(var(--node) / 2);
    width: 1px;
    height: calc(100% + var(--row-gap));
    background: var(--c-rule);
  }

  .nd__seg::after {
    content: '';
    position: absolute;
    inset: 0 -0.5px;
    background: var(--c-fg);
    transform-origin: top;
  }

  .nd__note {
    margin-top: clamp(1.5rem, 4dvh, 2.5rem);
  }

  /* Momento: a linha corre de marco em marco e cada um acende quando ela chega */
  :global(.slide.is-active) .nd__seg::after {
    animation: pr-grow-y 0.18s linear calc(0.3s + var(--k) * 0.18s) both;
  }

  :global(.slide.is-active) .nd__node {
    animation: nd-light var(--m-fast) var(--ease) calc(0.3s + var(--k) * 0.18s) both;
  }

  :global(.slide.is-active) .nd__who,
  :global(.slide.is-active) .nd__copy {
    animation: pr-rise 0.45s var(--ease) calc(0.3s + var(--k) * 0.18s) both;
  }

  :global(.slide.is-active) .is-live .nd__node::after {
    animation: nd-ring var(--m-base) var(--ease) calc(0.45s + var(--k) * 0.18s) forwards;
  }

  @keyframes nd-light {
    from {
      opacity: 0.2;
      transform: scale(0.7);
    }
  }

  @keyframes nd-ring {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  /* Desktop: régua horizontal, 7 colunas iguais */
  @media (min-width: 60rem) and (min-aspect-ratio: 1/1) {
    .nd__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: calc(var(--gap) * 2);
    }

    .nd__title {
      max-width: 13em;
    }

    .nd__aside {
      flex: none;
      align-items: flex-end;
      max-width: 20em;
      padding-bottom: 0.35em;
      text-align: right;
    }

    .nd {
      --node: clamp(2.25rem, calc(var(--u) * 3.1), 4.25rem);
      --who-h: calc(var(--fs-mono) * 2.6);
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0;
      margin-block: auto;
      padding-block: clamp(1.5rem, calc(var(--u) * 2.4), 3.5rem);
    }

    .nd__ms {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: var(--who-h) var(--node) auto;
      grid-template-areas:
        'who'
        'node'
        'copy';
      row-gap: clamp(0.4rem, calc(var(--u) * 0.6), 0.9rem);
      padding-right: calc(var(--gap) * 0.7);
    }

    .nd__who {
      align-self: end;
    }

    .nd__you {
      margin: 0;
    }

    .nd__copy {
      padding-top: calc(var(--u) * 0.6);
    }

    .nd__seg {
      top: calc(var(--who-h) + clamp(0.4rem, calc(var(--u) * 0.6), 0.9rem) + var(--node) / 2);
      width: 100%;
      height: 1px;
    }

    .nd__seg::after {
      inset: -0.5px 0;
      transform-origin: left;
    }

    :global(.slide.is-active) .nd__seg::after {
      animation-name: pr-grow-x;
    }

    .nd__note {
      margin-top: 0;
    }
  }
</style>
