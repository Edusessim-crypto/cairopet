---
import { Picture } from 'astro:assets';
import Slide from '../Slide.astro';
import { FOUNDERS } from '../../../data/presentation';

const ALT: Record<string, string> = {
  João: 'João, fundador da CairoPet, trabalhando no notebook.',
  Eduardo: 'Eduardo, fundador da CairoPet, trabalhando no notebook de fone de ouvido.',
};
---

<Slide id="fundadores">
  <h2 class="pr-title fd__title" data-reveal="title" set:html={FOUNDERS.title} />

  <div class="fd">
    <div class="fd__people">
      {
        FOUNDERS.people.map((person) => (
          <figure class="fd__person" data-reveal>
            <div class="fd__photo">
              <Picture
                src={person.photo}
                alt={ALT[person.name] ?? person.name}
                formats={['avif', 'webp']}
                widths={[person.photo.width]}
                sizes="(min-width: 60rem) 17vw, 42vw"
                loading="eager"
                fetchpriority="low"
                decoding="async"
              />
            </div>
            <figcaption>
              <span class="fd__name">{person.name}</span>
              <span class="pr-mono fd__role">{person.role}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="fd__text">
      {FOUNDERS.paragraphs.map((p) => <p class="pr-text" data-reveal set:html={p} />)}
    </div>
  </div>
</Slide>

<style>
  .fd {
    display: grid;
    gap: clamp(1.5rem, 4dvh, 2.5rem);
    margin-top: clamp(1.5rem, 4.5dvh, 3.25rem);
  }

  .fd__people {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, calc(var(--u) * 1.6), 1.75rem);
  }

  .fd__person {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .fd__photo {
    overflow: hidden;
    aspect-ratio: 300 / 372;
    border-radius: 10px;
    background: var(--graphite);
  }

  .fd__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
  }

  .fd__person figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .fd__name {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .fd__role {
    color: var(--c-fg-2);
  }

  .fd__text {
    display: flex;
    flex-direction: column;
    gap: 1em;
    max-width: 38em;
  }

  .fd__text p:last-child {
    padding-bottom: clamp(1.1rem, 3dvh, 2rem);
    border-bottom: 1px solid var(--c-rule);
  }

  @media (max-width: 59.99rem), (max-aspect-ratio: 1/1) {
    .fd__people {
      max-width: 26rem;
    }

    .fd__photo {
      aspect-ratio: 4 / 4.2;
    }
  }

  @media (min-width: 60rem) and (min-aspect-ratio: 1/1) {
    .fd {
      margin-block: auto;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
      gap: calc(var(--gap) * 1.6);
      min-height: 0;
    }

    /* Fotos limitadas pela altura disponível: nunca empurram o texto para fora */
    .fd__people {
      width: min(100%, calc((100dvh - var(--pt) - var(--logo-h) - var(--head-gap) - var(--pb) - var(--fs-h1) * 1.1 - 7.5rem) * 1.6));
    }

    .fd__text {
      padding-top: 0.15em;
    }
  }
</style>
