---
import Slide from '../Slide.astro';
import { IMPLEMENTATION } from '../../../data/presentation';

// Régua de 7 dias: marcos nos dias 1, 3, 5 e 7; traços menores nos dias entre eles.
const between = Array.from({ length: IMPLEMENTATION.days }, (_, i) => i + 1).filter(
  (day) => !IMPLEMENTATION.milestones.some((m) => m.day === day),
);
---

<Slide id="implementacao">
  <div class="im__head">
    <h2 class="pr-title im__title" data-reveal="title" set:html={IMPLEMENTATION.title} />
    <p class="pr-lead" data-reveal>{IMPLEMENTATION.text}</p>
  </div>

  <div class="im__track">
    <span class="im__ticks" aria-hidden="true">
      {between.map((day) => <i style={`--day:${day}`} />)}
    </span>
    <ol class="im">
      {
        IMPLEMENTATION.milestones.map((m, i) => (
          <li class="im__ms" data-reveal>
            <span class="pr-node" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="im__copy">
              <p class="pr-mono im__day">Dia {m.day}</p>
              <h3 class="pr-h3 im__name">{m.title}</h3>
              <p class="pr-text">{m.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="im__note pr-text" data-reveal>
    {IMPLEMENTATION.note.map((line) => <span>{line}</span>)}
  </p>
</Slide>

<style>
  .im__head {
    display: flex;
    flex-direction: column;
    gap: 0.7em;
  }

  .im__track {
    position: relative;
    margin-top: clamp(1.5rem, 4.6dvh, 3rem);
  }

  /* Celular: régua vertical */
  .im {
    position: relative;
    display: grid;
    gap: clamp(1.1rem, 3dvh, 1.75rem);
  }

  .im::before {
    content: '';
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: calc(var(--fs-mono) * 1.375);
    width: 1px;
    background: var(--c-rule);
  }

  .im__ticks {
    display: none;
  }

  .im__ms {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .im__copy {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    padding-top: 0.2em;
  }

  .im__day {
    color: var(--c-fg);
    font-weight: 700;
  }

  .im__name {
    font-family: var(--font-display), 'Arial Black', sans-serif;
    font-weight: 400;
    letter-spacing: -0.025em;
  }

  .im__copy .pr-text {
    font-size: var(--fs-small);
  }

  .im__note {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
    max-width: 52em;
    margin-top: clamp(1.5rem, 4dvh, 2.5rem);
    padding: 0.2em 0 0.2em 1.1em;
    border-left: 2px solid var(--c-fg);
    font-size: var(--fs-small);
  }

  /* Desktop: régua horizontal de 7 dias; cada marco cai no seu dia */
  @media (min-width: 60rem) and (min-aspect-ratio: 1/1) {
    .im__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: calc(var(--gap) * 2);
    }

    .im__title {
      max-width: 15em;
    }

    .im__head .pr-lead {
      flex: none;
      max-width: 13em;
      padding-bottom: 0.35em;
      text-align: right;
    }

    .im__track {
      --node: calc(var(--fs-mono) * 2.75);
      margin-top: auto;
      padding-top: clamp(1.5rem, calc(var(--u) * 2.6), 3.5rem);
    }

    .im {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    .im::before {
      top: calc(var(--node) / 2);
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 1px;
    }

    .im__ticks {
      position: absolute;
      inset: clamp(1.5rem, calc(var(--u) * 2.6), 3.5rem) 0 auto 0;
      display: block;
      height: var(--node);
    }

    /* Dia N a 12,5% por dia (4 colunas = dias 1, 3, 5, 7) */
    .im__ticks i {
      position: absolute;
      top: 50%;
      left: calc((var(--day) - 1) * 12.5% + var(--node) / 2);
      width: 1px;
      height: 0.6rem;
      background: var(--c-fg-2);
      transform: translateY(-50%);
    }

    .im__ms {
      grid-template-columns: 1fr;
      align-content: start;
      gap: clamp(1rem, calc(var(--u) * 1.8), 2.25rem);
      padding-right: calc(var(--gap) * 1.2);
    }

    .im__note {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 0.35em;
      max-width: none;
      margin-top: auto;
    }
  }
</style>
