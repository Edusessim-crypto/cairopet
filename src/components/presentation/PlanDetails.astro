---
/**
 * "Ver tudo o que está incluso": tudo o que o plano entrega, sem repetição.
 * Seções por nível (Presença → + Crescimento → + Performance); cada pilar
 * aparece uma vez, na versão mais alta, com todas as atividades por trás dele.
 */
import CheckIcon from './CheckIcon.astro';
import { PLANS, planSections } from '../../data/presentation';

const order = PLANS.plans.map((p) => p.id);
---

{
  PLANS.plans.map((plan) => {
    const sections = planSections(plan);
    const level = order.indexOf(plan.id);
    return (
      <dialog class="pd" id={`incluso-${plan.id}`} data-plan-dialog={plan.id} aria-labelledby={`incluso-${plan.id}-nome`}>
        <div class="pd__inner">
          <header class="pd__head">
            <p class="pd__eyebrow pr-mono">{PLANS.more.replace(/^Ver /, '')}</p>
            <h2 class="pd__name" id={`incluso-${plan.id}-nome`}>
              {plan.name}
            </h2>
            <p class="pd__price">
              R$ {plan.price}
              <span>{plan.period}</span>
            </p>
            <p class="pd__text">{plan.text}</p>
            <button class="pd__close" type="button" data-plan-close aria-label="Fechar">
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="m5 5 10 10M15 5 5 15" />
              </svg>
            </button>
          </header>

          <ol class="pd__path pr-mono" aria-label="Evolução dos planos">
            {PLANS.plans.map((p, i) => (
              <li class:list={{ 'is-in': i <= level, 'is-current': i === level }}>{p.name}</li>
            ))}
          </ol>

          {sections.map(({ plan: tier, pillars }, i) => (
            <section class="pd__section" aria-labelledby={`incluso-${plan.id}-${tier.id}`}>
              <header class="pd__section-head">
                <h3 class="pr-mono" id={`incluso-${plan.id}-${tier.id}`}>
                  {i > 0 && <span aria-hidden="true">+ </span>}
                  {tier.name}
                </h3>
                <p>{tier.role}</p>
              </header>

              <div class="pd__grid">
                {pillars.map((pillar) => (
                  <article class="pd__pillar">
                    <h4 class="pd__pillar-name">
                      {pillar.title}
                      {pillar.evolved && <span class="pd__tag pr-mono">Evolução</span>}
                    </h4>
                    {pillar.detail && <p class="pd__detail">{pillar.detail}</p>}
                    <ul class="pd__acts">
                      {pillar.activities.map((activity) => (
                        <li>
                          <CheckIcon />
                          <span>{activity}</span>
                        </li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </dialog>
    );
  })
}

<style>
  .pd {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--black);
    color: var(--white);
    overscroll-behavior: contain;
    --focus: var(--white);
    --pd-fg-2: rgb(255 255 255 / 0.68);
    --pd-rule: rgb(255 255 255 / 0.16);
  }

  .pd::backdrop {
    background: var(--black);
  }

  .pd[open] {
    display: flex;
    animation: pd-in 0.32s var(--ease) both;
  }

  @keyframes pd-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .pd__inner {
    width: 100%;
    max-width: 84rem;
    margin: auto;
    padding: clamp(1.25rem, 5vw, 3.5rem) var(--px);
  }

  .pd__head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-right: 3.5rem;
  }

  .pd__eyebrow {
    flex-basis: 100%;
    color: var(--pd-fg-2);
  }

  .pd__name {
    font-family: var(--font-display), 'Arial Black', sans-serif;
    font-size: var(--fs-h1);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .pd__price {
    font-family: var(--font-display), 'Arial Black', sans-serif;
    font-size: var(--fs-h2);
    letter-spacing: -0.03em;
  }

  .pd__price span {
    margin-left: 0.1em;
    color: var(--pd-fg-2);
    font-family: var(--font-body), system-ui, sans-serif;
    font-size: 0.5em;
    font-weight: 500;
    letter-spacing: 0;
  }

  .pd__text {
    flex-basis: 100%;
    max-width: 40em;
    color: var(--pd-fg-2);
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  .pd__close {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 50%;
    background: none;
    color: var(--white);
  }

  .pd__close:hover {
    border-color: var(--white);
  }

  .pd__close svg {
    width: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* PRESENÇA → CRESCIMENTO → PERFORMANCE: onde este plano está na evolução */
  .pd__path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: clamp(1.25rem, 3dvh, 2rem);
    padding-block: 0.9rem;
    border-block: 1px solid var(--pd-rule);
    color: rgb(255 255 255 / 0.32);
  }

  .pd__path li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pd__path li + li::before {
    content: '→';
    color: rgb(255 255 255 / 0.32);
  }

  .pd__path .is-in {
    color: var(--pd-fg-2);
  }

  .pd__path .is-current {
    color: var(--white);
    font-weight: 700;
  }

  .pd__section {
    margin-top: clamp(1.75rem, 4.5dvh, 3rem);
  }

  .pd__section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    margin-bottom: 1rem;
  }

  .pd__section-head h3 {
    font-weight: 700;
  }

  .pd__section-head p {
    color: var(--pd-fg-2);
    font-size: var(--fs-small);
  }

  .pd__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0 var(--gap);
  }

  .pd__pillar {
    padding-block: 1rem 1.25rem;
    border-top: 1px solid var(--pd-rule);
  }

  .pd__pillar-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    font-size: calc(var(--fs-body) * 1.06);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .pd__tag {
    padding: 0.2em 0.5em;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 4px;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .pd__detail {
    margin-top: 0.3rem;
    color: var(--pd-fg-2);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .pd__acts {
    display: grid;
    gap: 0.45em;
    margin-top: 0.85rem;
    color: rgb(255 255 255 / 0.85);
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .pd__acts li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.6em;
  }

  @media (prefers-reduced-motion: reduce) {
    .pd[open] {
      animation: none;
    }
  }
</style>
