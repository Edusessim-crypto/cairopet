---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import LeadForm from '../components/form/LeadForm.astro';
---

<BaseLayout
  title="Minha cidade ainda está livre? | CairoPet"
  description="Conte sobre a sua agropecuária e descubra se a sua cidade ainda está disponível. A CairoPet atende uma agropecuária por cidade."
  noindex
>
  <a class="skip" href="#formulario">Pular para o formulário</a>
  <Header variant="minimal" />
  <main class="fp" id="formulario">
    <div class="fp__in">
      <h1 class="visually-hidden">Minha cidade ainda está livre? Formulário da CairoPet</h1>
      <LeadForm />
      <p class="fp__foot">
        Sem compromisso de contratação · Uma agropecuária por cidade ·
        <a href="/politica-de-privacidade/">Privacidade</a>
      </p>
    </div>
  </main>
</BaseLayout>

<script>
  import { initLeadForm } from '../scripts/lead-form';
  initLeadForm();
</script>

<style>
  .fp {
    min-height: calc(100svh - var(--header-h));
    padding-bottom: 3rem;
  }

  .fp__in {
    width: 100%;
    max-width: calc(40rem + var(--pad) * 2);
    margin-inline: auto;
    padding-inline: var(--pad);
  }

  .fp__foot {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: 0.8125rem;
  }
</style>
