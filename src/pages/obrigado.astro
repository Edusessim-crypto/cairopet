---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Stamp from '../components/Stamp.astro';
import { CALENDLY_URL } from '../lib/site';
---

<BaseLayout title="Recebemos sua agropecuária | CairoPet" noindex>
  <Header variant="minimal" />
  <main class="ty" id="conteudo">
    <div class="ty__in">
      <Stamp size="6.5rem" />
      <h1 class="h2 ty__title">Recebemos sua agropecuária<span data-ty-name></span>.</h1>
      <p class="lead">
        Agora a gente confere a disponibilidade da sua cidade e analisa as informações que você enviou.
      </p>

      <div class="ty__next">
        <p class="kicker">Próximo passo</p>
        <h2 class="h3">Agende o briefing com a CairoPet.</h2>
        <p class="fg-2">
          Uma conversa para entender a loja, a cidade e o que você quer melhorar. Escolha o horário que funciona para você.
        </p>
        <a class="btn ty__cal" href={CALENDLY_URL} target="_blank" rel="noopener" data-calendly data-cta="obrigado-calendly">
          <span>Agendar meu briefing</span>
          <span class="btn__arrow" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M2.5 8h10M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
        </a>
        <p class="ty__note">
          Prefere não agendar agora? Sem problema: se houver compatibilidade, a gente entra em contato pelos dados que você
          informou.
        </p>
      </div>
      <a class="textlink" href="/">Voltar para o site</a>
    </div>
  </main>
</BaseLayout>

<script>
  import { track, trackLead } from '../scripts/tracking';
  import { getAttribution } from '../scripts/attribution';

  // Lead só dispara vindo de envio confirmado pelo servidor (mesmo event_id da CAPI).
  const id = new URLSearchParams(location.search).get('lead');
  let nome = '';
  try {
    nome = sessionStorage.getItem('cp_lead_nome') ?? '';
  } catch {
    /* ignora */
  }
  if (id && /^[\w-]{8,64}$/.test(id)) {
    let valid = true;
    try {
      valid = sessionStorage.getItem('cp_lead_pending') === id;
      if (valid) sessionStorage.removeItem('cp_lead_pending');
    } catch {
      /* sessão indisponível: confia no parâmetro */
    }
    if (valid) trackLead(id);
    history.replaceState(null, '', location.pathname);
  }

  const first = nome.trim().split(/\s+/)[0];
  const slot = document.querySelector('[data-ty-name]');
  if (first && slot) slot.textContent = `, ${first}`;

  // Calendly com nome e UTMs pré-preenchidos.
  const cal = document.querySelector<HTMLAnchorElement>('[data-calendly]');
  if (cal) {
    const url = new URL(cal.href);
    if (nome) url.searchParams.set('name', nome);
    const attr = getAttribution();
    for (const k of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']) if (attr[k]) url.searchParams.set(k, attr[k]);
    cal.href = url.toString();
    cal.addEventListener('click', () => track('calendly_click', { location: 'obrigado' }));
  }
</script>

<style>
  .ty {
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }
  .ty__in {
    max-width: calc(40rem + var(--pad) * 2);
    margin-inline: auto;
    padding-inline: var(--pad);
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .ty__title {
    margin-top: 0.5rem;
  }
  .ty__next {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    margin-block: 1rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border-radius: var(--r);
    background: var(--mist);
  }
  .ty__next .kicker {
    margin: 0;
  }
  .ty__cal {
    justify-self: start;
    margin-top: 0.5rem;
  }
  .ty__note {
    color: var(--ink-2);
    font-size: var(--t-small);
  }
  @media (max-width: 39.99rem) {
    .ty__cal {
      justify-self: stretch;
    }
  }
</style>
