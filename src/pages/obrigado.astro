---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/brand/Logo.astro';
---

<BaseLayout title="Recebemos suas informações | CairoPet" noindex>
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" slot="head" />

  <main class="ok" id="conteudo">
    <header class="ok__top">
      <a href="/" aria-label="CairoPet — página inicial"><Logo variant="black" width={88} loading="eager" alt="" /></a>
    </header>

    <div class="ok__body">
      <div class="ok__badge">
        <svg class="ok__check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="8" fill="#25d366"/>
          <path d="M4.5 8.25L6.75 10.5L11.5 5.5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Cadastro recebido com sucesso</span>
      </div>

      <h1 class="ok__title">Agora agende seu briefing gratuito</h1>
      <p class="ok__text">Em 30 minutos, nossa equipe analisa o perfil da sua agropecuária e mostra exatamente o que pode mudar no seu marketing.</p>

      <div class="ok__card">
        <div class="ok__card-items">
          <div class="ok__item">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><rect x="2" y="3" width="14" height="13" rx="2" stroke="#111" stroke-width="1.5"/><path d="M2 7h14" stroke="#111" stroke-width="1.5"/><path d="M6 1v2M12 1v2" stroke="#111" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>Você escolhe o dia e horário</span>
          </div>
          <div class="ok__item">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="7" stroke="#111" stroke-width="1.5"/><path d="M9 5.5V9l2.5 2" stroke="#111" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>30 minutos, sem enrolação</span>
          </div>
          <div class="ok__item">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="7" stroke="#111" stroke-width="1.5"/><path d="M6 9.25L8 11.5L12 6.5" stroke="#111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Diagnóstico gratuito, sem compromisso</span>
          </div>
        </div>

        <a
          class="ok__btn"
          href=""
          id="btn-calendly"
          data-track="calendly_open"
          data-location="obrigado"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2.5" y="3.5" width="15" height="14" rx="2" stroke="#fff" stroke-width="1.5"/><path d="M2.5 8h15" stroke="#fff" stroke-width="1.5"/><path d="M7 1.5v2M13 1.5v2" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Escolher meu horário agora</span>
        </a>
        <p class="ok__disclaimer">Gratuito · Sem compromisso · Atendemos 1 empresa por cidade</p>
      </div>
    </div>
  </main>

  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>
</BaseLayout>

<script>
  document.getElementById('btn-calendly')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.Calendly?.initPopupWidget({ url: 'https://calendly.com/cairopet/briefing-cairopet' });

    // GTM: abertura do Calendly
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'calendly_open', location: 'obrigado' });
  });

  // GTM: agendamento confirmado
  window.addEventListener('message', (e) => {
    if (e.origin !== 'https://calendly.com') return;
    if (e.data?.event === 'calendly.event_scheduled') {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'calendly_scheduled', location: 'obrigado' });
    }
  });
</script>

<style>
  .ok {
    --side: clamp(1rem, 5.5vw, 1.5rem);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    max-width: 36rem;
    margin-inline: auto;
    padding: env(safe-area-inset-top) var(--side) calc(2rem + env(safe-area-inset-bottom));
  }

  .ok__top {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 56px;
  }

  .ok__top :global(.logo) {
    width: 84px;
    height: auto;
  }

  .ok__body {
    display: grid;
    gap: 1.25rem;
    padding-top: clamp(1.75rem, 6vh, 3rem);
  }

  .ok__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #1a9e50;
    letter-spacing: 0.01em;
  }

  .ok__title {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(1.875rem, 1.3rem + 2.6vw, 2.75rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin-top: -0.25rem;
  }

  .ok__text {
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.55;
    text-wrap: pretty;
    max-width: 30rem;
  }

  .ok__card {
    display: grid;
    gap: 1rem;
    margin-top: 0.5rem;
    padding: 1.5rem;
    border: 1.5px solid var(--rule);
    border-radius: 16px;
    background: var(--mist);
  }

  .ok__card-items {
    display: grid;
    gap: 0.75rem;
  }

  .ok__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .ok__item svg {
    flex: none;
  }

  .ok__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 60px;
    margin-top: 0.25rem;
    padding: 0 1.25rem;
    border-radius: 12px;
    background: var(--ink);
    color: #fff;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
    transition: opacity 0.15s;
  }

  .ok__btn:hover,
  .ok__btn:active {
    opacity: 0.82;
  }

  .ok__btn span {
    text-align: center;
    text-wrap: balance;
  }

  .ok__disclaimer {
    font-size: 0.8125rem;
    color: var(--ink-3);
    text-align: center;
    line-height: 1.4;
  }

  @media (max-width: 23.74rem) {
    .ok__btn {
      padding-inline: 0.875rem;
      font-size: 1rem;
    }
    .ok__card {
      padding: 1.125rem;
    }
  }

  @media (min-width: 40rem) {
    .ok__btn {
      font-size: 1.125rem;
    }
  }

</style>
