---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/brand/Logo.astro';
---

<BaseLayout title="Recebemos suas informações | CairoPet" noindex>
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" slot="head" />

  <main class="ok" id="conteudo">
    <header class="ok__top">
      <a href="/" aria-label="CairoPet — página inicial"><Logo variant="black" width={88} loading="eager" alt="" /></a>
    </header>

    <div class="ok__body">
      <h1 class="ok__title">Recebemos suas informações!</h1>
      <p class="ok__text">Escolha um horário para o seu briefing com nossa equipe.</p>

      <a
        class="ok__btn"
        href=""
        id="btn-calendly"
        data-track="calendly_open"
        data-location="obrigado"
      >
        <span>Agendar meu briefing</span>
      </a>
    </div>
  </main>

  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async is:inline></script>
</BaseLayout>

<script>
  document.getElementById('btn-calendly')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.Calendly?.initPopupWidget({ url: 'https://calendly.com/cairopet/briefing-cairopet' });

    // GTM: abertura do Calendly
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'calendly_open', location: 'obrigado' });
  });

  // GTM: agendamento confirmado
  window.addEventListener('message', (e) => {
    if (e.origin !== 'https://calendly.com') return;
    if (e.data?.event === 'calendly.event_scheduled') {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'calendly_scheduled', location: 'obrigado' });
    }
  });
</script>

<style>
  .ok {
    --side: clamp(1rem, 5.5vw, 1.5rem);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    max-width: 34rem;
    margin-inline: auto;
    padding: env(safe-area-inset-top) var(--side) calc(1.5rem + env(safe-area-inset-bottom));
  }

  .ok__top {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 56px;
  }

  .ok__top :global(.logo) {
    width: 84px;
    height: auto;
  }

  .ok__body {
    display: grid;
    gap: 1rem;
    padding-top: clamp(1.5rem, 8vh, 4rem);
  }


  .ok__title {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .ok__text {
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .ok__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 60px;
    margin-top: 0.75rem;
    padding: 0 1.25rem;
    border-radius: 12px;
    background: var(--ink);
    color: var(--bg);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
  }

  .ok__btn:hover,
  .ok__btn:active {
    opacity: 0.85;
  }

  .ok__btn span {
    text-align: center;
    text-wrap: balance;
  }

  @media (max-width: 23.74rem) {
    .ok__btn {
      padding-inline: 0.875rem;
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 40rem) {
    .ok__btn {
      font-size: 1.125rem;
    }
  }


</style>
