---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/brand/Logo.astro';
import { CALENDLY_URL } from '../lib/site';
---

<BaseLayout title="Recebemos sua agropecuária | CairoPet" noindex>
  <main class="ok" id="conteudo">
    <header class="ok__top">
      <a href="/" aria-label="CairoPet — página inicial"><Logo variant="black" width={88} loading="eager" alt="" /></a>
    </header>

    <div class="ok__body">
      <h1 class="ok__title">Recebemos sua agropecuária.</h1>
      <p class="ok__text">
        Suas informações foram enviadas com sucesso. Agora escolha o melhor horário para conversarmos sobre sua loja.
      </p>

      <a class="ok__btn" href={CALENDLY_URL} data-calendly data-cta="obrigado-calendly">
        <span>Agendar meu briefing</span>
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8h10M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <p class="ok__hint">Escolha o melhor dia e horário para você.</p>
    </div>
  </main>
</BaseLayout>

<script>
  import { track, trackLead } from '../scripts/tracking';
  import { getAttribution } from '../scripts/attribution';

  // Lead só dispara vindo de envio confirmado pelo servidor (mesmo event_id da CAPI).
  const id = new URLSearchParams(location.search).get('lead');
  if (id && /^[\w-]{8,64}$/.test(id)) {
    let valid = true;
    try {
      valid = sessionStorage.getItem('cp_lead_pending') === id;
      if (valid) sessionStorage.removeItem('cp_lead_pending');
    } catch {
      /* sessão indisponível: confia no parâmetro */
    }
    if (valid) trackLead(id);
    history.replaceState(null, '', location.pathname);
  }

  // Calendly na mesma aba, só ao toque do usuário, com as UTMs da campanha.
  const cal = document.querySelector<HTMLAnchorElement>('[data-calendly]');
  if (cal) {
    const url = new URL(cal.href);
    const attr = getAttribution();
    for (const k of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']) if (attr[k]) url.searchParams.set(k, attr[k]);
    cal.href = url.toString();
    cal.addEventListener('click', () => track('calendly_click', { location: 'obrigado' }));
  }
</script>

<style>
  .ok {
    --side: clamp(1rem, 5.5vw, 1.5rem);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    max-width: 34rem;
    margin-inline: auto;
    padding: env(safe-area-inset-top) var(--side) calc(1.5rem + env(safe-area-inset-bottom));
  }

  .ok__top {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 56px;
  }

  .ok__top :global(.logo) {
    width: 84px;
    height: auto;
  }

  .ok__body {
    display: grid;
    gap: 1rem;
    padding-top: clamp(1.5rem, 8vh, 4rem);
  }


  .ok__title {
    font-family: var(--font-display), sans-serif;
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .ok__text {
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .ok__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 60px;
    margin-top: 0.75rem;
    padding: 0 1.25rem;
    border-radius: 12px;
    background: var(--ink);
    color: var(--white);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    touch-action: manipulation;
  }

  .ok__btn:active {
    background: var(--graphite);
  }

  .ok__btn svg {
    width: 18px;
    height: 18px;
  }

  .ok__hint {
    margin-top: -0.25rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    text-align: center;
  }

</style>
